{
  "sites": [
    {
      "subject": "example.tld",
      "altnames": ["example.tld", "www.example.tld"],
      "renewAt": 1
    }
  ],
  "defaults": {
    "subscriberEmail": "YOUR_EMAIL_HERE",
    "renewOffset": "-45d",
    "renewStagger": "3d",
    "accountKeyType": "EC-P256",
    "serverKeyType": "RSA-2048",
    "store": {
      "module": "greenlock-store-fs"
    },
    "challenges": {
      "http-01": {
        "module": "acme-http-01-standalone"
      }
    }
  }
}
