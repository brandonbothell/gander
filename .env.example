# Environment variables declared in this file are automatically made available in process.env on the server side.
# Environment variables declared with the VITE_ prefix are automatically made available in import.meta.env on the client side.

# Be sure to rebuild the client AND restart the server after changing anything to prevent unexpected behavior.

DATABASE_URL =              "file:./example.sqlite"
JWT_SECRET =                "example_jwt_secret"

#API_ENV =                  "production"
API_ENV =                   "development"

DEBUG_MOTION =              "false"

VITE_GOOGLE_MAPS_API_KEY =  "example_google_maps_api_key"

# This is optional; it overwrites what would normally be Same-Site requests from the client to '/api/*' to requests to 'https://example.tld/api/*'
# VITE_API_BASE_URL =       "https://example.tld"

VITE_REACT_APP_VERSION =    "1.0.0"

# Development mode means the Android app is allowed to be served over HTTP instead of HTTPS, which should ONLY be used when testing the app in Android Studio.
# Development mode also automatically serves the app from localhost instead of local files or ANDROID_BASE_APP_URL.
# ANDROID_ENV =             "production"
VITE_ANDROID_ENV =          "development"

# This is required to prevent the app from attempting to send API requests the local device if you don't set ANDROID_BASE_APP_URL.
# It overwrites what would normally be Same-Site requests from the client to '/api/*' to requests to 'https://example.tld/api/*'
# If not present, VITE_API_BASE_URL is used (if it's there). Otherwise, the mobile app will error when attempting to manage notifications.
VITE_ANDROID_API_BASE_URL = "https://example.tld"

# This is optional; will cause the Android app to point to this domain instead of serving from local files.
# (NOT recommended for security reasons, as you may not own your domain forever, while a user may keep an old version of an app installed)
# ANDROID_APP_BASE_URL =    "https://m.example.tld"
