#   ----------------------------
#   ------- Information --------
#   ----------------------------


# Environment variables declared in this file are automatically made available in process.env on the server side.
# Environment variables declared with the CLIENT_ prefix are automatically made available in import.meta.env on the client side.

# Be sure to rebuild the client AND restart the server after changing anything to prevent unexpected behavior.


#   ----------------------------
#   ---------- Server ----------
#   ----------------------------


# The database URL should point to a sqlite file in the project directory.
DATABASE_URL =                "file:./example.sqlite"

# The JWT secret should be long and unique.
JWT_SECRET =                  "example_jwt_secret"

# Development mode doesn't enfore HTTPS encryption, which is unsafe in production environments.
# Development mode also allows requests from localhost through CORS.
API_ENV =                     "development"
# API_ENV =                   "production"


#   ----------------------------
#   ----------- Web ------------
#   ----------------------------


CLIENT_GOOGLE_MAPS_API_KEY =  "example_google_maps_api_key"


#   ----------------------------
#   --------- Android ----------
#   ----------------------------


# Development mode means the Android app is allowed to be served over HTTP instead of HTTPS, which should ONLY be used when testing the app in Android Studio.
# Development mode also automatically builds the app to make API requests to the local server instead of using CLIENT_ANDROID_API_BASE_URL or CLIENT_API_BASE_URL.
CLIENT_ANDROID_ENV =          "development"
# CLIENT_ANDROID_ENV =        "production"

# This convinces other apps (such as password managers) to that the app is on this site. It shouldn't be an accessible URL on the server.
ANDROID_HOSTNAME = "app.example.tld"

# This is required to prevent the app from attempting to send API requests the local device if you don't set ANDROID_APP_BASE_URL.
# It overwrites what would normally be Same-Site requests from the client to '/api/*' to 'https://example.tld/api/*' instead.
# If not present, CLIENT_API_BASE_URL is used (if it's there). Otherwise, the mobile app will not function when served from local files.
CLIENT_ANDROID_API_BASE_URL = "https://example.tld"

# This is required to run the app in the Android Studio emulator. Set it to your server's local IP & port.
CLIENT_ANDROID_API_BASE_URL_DEVELOPMENT = "http://192.168.0.5:3000"


#   ----------------------------
#   --------- Optional ---------
#   ----------------------------


# This overwrites what would normally be Same-Site requests from the client to '/api/*' to requests to 'https://example.tld/api/*'
# CLIENT_API_BASE_URL =       "https://example.tld"

# Makes the Android app point to this domain instead of serving from local files.
# (*not* recommended for security reasons, as you may not own your domain forever, while a user may keep an old version of an app installed)
# ANDROID_APP_BASE_URL =      "https://example.tld"

# Logs a ton of extra motion debugging info to files and the server console. Only use when necessary.
# DEBUG_MOTION =              "false"
